---
import "../styles/global.css";

const { title = "matikda" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
	<script is:inline>
    const savedTheme = localStorage.getItem("theme") || "april-shower";
		document.documentElement.setAttribute("data-theme", savedTheme);
    document.documentElement.setAttribute("data-mode", "light");
	</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
