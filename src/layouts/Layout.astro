---
import "../styles/global.css";

const { title = "matikda" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme") || "april-shower";
        const savedMode = localStorage.getItem("mode") || "light";

		document.documentElement.setAttribute("data-mode", savedMode);

        document.documentElement.dataset.theme = savedTheme;
        document.documentElement.dataset.mode = savedMode;
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

	<link
	rel="icon"
	type="image/svg+xml"
	href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath fill='%23f2c66d' d='M7 1h2v3h3v2h3v5h-3v3H4v-3H1V6h3V4h3z'/%3E%3C/svg%3E"
	/>

  </head>

  <body>
    <slot />
  </body>
</html>