---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import World from "../components/World.astro";


const themes = [
    { name: "april-shower", label: "april-shower" },
    { name: "winter", label: "winter" },
    { name: "spring", label: "spring" },
    { name: "autumn", label: "autumn" },
    { name: "summer", label: "summer" },
    { name: "june", label: "june" },
    { name: "academia", label: "academia" },
    { name: "rainy-day", label: "rainy-day" },
    { name: "library", label: "library" },
    { name: "flowers", label: "flowers" },
    { name: "bright", label: "bright" },
    { name: "roses", label: "roses" }
];
---

<Layout title="matikda">
  <Navigation />

  <main>
    <World />
  </main>
  <select id="theme-selector" aria-label="Select theme">
            {themes.map((theme) => (
                <option value={theme.name}>
                    {theme.label}
                </option>
            ))}
        </select>

</Layout>

<style>
    
    #theme-selector {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 1000;
        box-shadow: 0 0;
        padding: 0 0;
        border: 0;
        color: var(--theme-accent-400);
        width: auto;
        appearance: none;
        -webkit-appearance: none;
    }
    #theme-selector:hover {
        color: var(--theme-accent-600);
    }
    #theme-selector:focus {
        color: var(--theme-accent-600);
        outline: none;
    }
</style>